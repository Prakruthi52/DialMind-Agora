# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Murf AI Falcon TTS (required; server-side only). Get a key at https://murf.ai/api/dashboard
NEXT_MURF_API_KEY=
NEXT_MURF_VOICE_ID=hi-IN-poonam
NEXT_MURF_LOCALE=hi-IN

# Anam video avatar (server-side only). Get a key at https://lab.anam.ai
NEXT_ENABLE_AVATAR=true
NEXT_ANAM_API_KEY=
NEXT_ANAM_AVATAR_ID=a7eb25e8-8c31-460d-a397-8cd8010c76d1

# Interview engine
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=   (Turso only)
TOOL_SECRET=
PUBLIC_BASE_URL=

# Sarvam STT (Marathi, Malayalam, Punjabi, Odia). Get a key at https://dashboard.sarvam.ai
NEXT_SARVAM_API_KEY=
NEXT_PUBLIC_SARVAM_ENABLED=false

# Claims console: post-call LLM judge (Google Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Call recordings (Vercel Blob). Create a Blob store in Vercel > Storage and connect it to the project
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_RECORDING_ENABLED=false

# WhatsApp claim confirmations (Twilio; sandbox for the demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+17372508034
TWILIO_SMS_FROM=
